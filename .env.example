# Backend base URL (no trailing slash, no /api/v1). The prod backend currently
# sits on a bare IP with a self-signed cert — open it once in the browser and
# accept the certificate, or API calls will fail with a network error.
VITE_API_BASE_URL=http://localhost:3000

# Google Maps JavaScript API key for the dashboard (browser key, HTTP-referrer
# restricted). NOT the backend's GOOGLE_PLACES_API_KEY and NOT the Android app key.
# Leave empty to run without maps — map areas show a placeholder.
VITE_GOOGLE_MAPS_API_KEY= 

# Optional Map ID (required for Advanced Markers in production). Falls back to
# Google's DEMO_MAP_ID when empty.
VITE_GOOGLE_MAPS_MAP_ID=
